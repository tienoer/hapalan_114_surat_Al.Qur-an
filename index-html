          localStorage.setItem('quran_hafalan_progress', JSON.stringify(memorizedData));
        } catch (e) {
          console.error("Gagal menyimpan progres ke localStorage", e);
        }
      }, [memorizedData]);

      // Handle Audio Event Listeners
      useEffect(() => {
        const audio = audioRef.current;

        const handleTimeUpdate = () => {
          setCurrentTime(audio.currentTime);
          setDuration(audio.duration || 0);
        };

        const handleEnded = () => {
          // Check repeat count requirement
          if (currentRepeatCount < repeatTarget) {
            setCurrentRepeatCount(prev => prev + 1);
            audio.currentTime = 0;
            audio.play().catch(err => console.error(err));
          } else {
            // Reached repeat target for this verse
            setCurrentRepeatCount(1);
            
            // Check study mode
            if (mode === 'tirukan') {
              // Pause and countdown for user recitation
              const silenceDuration = Math.max(4, Math.round(audio.duration || 5));
              startRecitationCountdown(silenceDuration);
            } else {
              // Advance to next verse
              advanceToNextAyah();
            }
          }
        };

        const handleError = (e) => {
          console.error("Audio error:", e);
          setIsPlaying(false);
          setFetchError("Audio gagal diputar dari server. Menggunakan jalur cadangan...");
          // Try fallback URL if available
          if (verses.length > 0 && verses[currentAyahIndex]) {
            const fallbackUrl = `https://cdn.islamic.network/quran/audio/128/${reciter}/${verses[currentAyahIndex].globalNumber}.mp3`;
            if (audio.src !== fallbackUrl) {
              audio.src = fallbackUrl;
              audio.play().then(() => {
                setIsPlaying(true);
                setFetchError(null);
              }).catch(() => {
                setFetchError("Audio gagal diputar. Periksa koneksi internet Anda.");
              });
            }
          }
        };

        audio.addEventListener('timeupdate', handleTimeUpdate);
        audio.addEventListener('ended', handleEnded);
        audio.addEventListener('error', handleError);

        return () => {
          audio.removeEventListener('timeupdate', handleTimeUpdate);
          audio.removeEventListener('ended', handleEnded);
          audio.removeEventListener('error', handleError);
        };
      }, [currentRepeatCount, repeatTarget, mode, currentAyahIndex, verses, reciter]);

      // Apply Volume & Playback Rate
      useEffect(() => {
        if (audioRef.current) {
          audioRef.current.volume = isMuted ? 0 : volume;
          audioRef.current.playbackRate = playbackSpeed;
        }
      }, [volume, isMuted, playbackSpeed]);

      // Timer helper for Mode Tirukan
      const startRecitationCountdown = (seconds) => {
        setIsPauseCountdown(true);
        setCountdownSeconds(seconds);
        
        if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);

        countdownTimerRef.current = setInterval(() => {
          setCountdownSeconds(prev => {
            if (prev <= 1) {
              clearInterval(countdownTimerRef.current);
              setIsPauseCountdown(false);
              advanceToNextAyah();
              return 0;
            }
            return prev - 1;
          });
        }, 1000);
      };

      const advanceToNextAyah = () => {
        if (currentAyahIndex < verses.length - 1) {
          const nextIdx = currentAyahIndex + 1;
          setCurrentAyahIndex(nextIdx);
          playAyah(nextIdx);
        } else {
          // Reached end of surah
          setIsPlaying(false);
          setCurrentAyahIndex(0);
        }
      };

      // Fetch Verses & Audio for selected surah
      const loadSurah = async (surah) => {
        setSelectedSurah(surah);
        setView('workbench');
        setLoadingVerses(true);
        setFetchError(null);
        setVerses([]);
        setCurrentAyahIndex(0);
        setIsPlaying(false);
        setRevealedAyahs({});
        audioRef.current.pause();

        try {
          // Fetch Arabic text + audio, and Indonesian translation
          const res = await fetch(`https://api.alquran.cloud/v1/surah/${surah.number}/editions/${reciter},id.indonesian`);
          const json = await res.json();

          if (json.code === 200 && json.data && json.data.length >= 2) {
            const arEdition = json.data[0];
            const idEdition = json.data[1];

            const formattedVerses = arEdition.ayahs.map((ayah, idx) => ({
              numberInSurah: ayah.numberInSurah,
              globalNumber: ayah.number,
              text: ayah.text,
              audio: ayah.audio || `https://cdn.islamic.network/quran/audio/128/${reciter}/${ayah.number}.mp3`,
              translation: idEdition.ayahs[idx] ? idEdition.ayahs[idx].text : ''
            }));

            setVerses(formattedVerses);
            setupQuizMode(formattedVerses);
          } else {
            throw new Error("Gagal mengambil data dari server API Al-Qur'an.");
          }
        } catch (err) {
          console.error("Error fetching surah:", err);
          setFetchError("Gagal memuat ayat dan suara Al-Qur'an. Silakan coba lagi.");
        } finally {
          setLoadingVerses(false);
        }
      };

      // Change Reciter and re-fetch audio URLs if needed
      const handleReciterChange = async (newReciter) => {
        setReciter(newReciter);
        if (selectedSurah) {
          const wasPlaying = isPlaying;
          audioRef.current.pause();
          setIsPlaying(false);
          
          setLoadingVerses(true);
          try {
            const res = await fetch(`https://api.alquran.cloud/v1/surah/${selectedSurah.number}/editions/${newReciter},id.indonesian`);
            const json = await res.json();
            if (json.code === 200) {
              const arEdition = json.data[0];
              setVerses(prevVerses => prevVerses.map((v, i) => ({
                ...v,
                audio: arEdition.ayahs[i].audio || `https://cdn.islamic.network/quran/audio/128/${newReciter}/${v.globalNumber}.mp3`
              })));
            }
          } catch (e) {
            console.error(e);
          } finally {
            setLoadingVerses(false);
          }
        }
      };

      // Play specific verse
      const playAyah = (index) => {
        if (!verses || verses.length === 0 || !verses[index]) return;
        
        if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);
        setIsPauseCountdown(false);

        setCurrentAyahIndex(index);
        const ayah = verses[index];
        audioRef.current.src = ayah.audio;
        audioRef.current.currentTime = 0;
        audioRef.current.playbackRate = playbackSpeed;
        audioRef.current.volume = isMuted ? 0 : volume;

        audioRef.current.play()
          .then(() => {
            setIsPlaying(true);
            setFetchError(null);
            // Scroll ayah card into view smoothly
            const el = document.getElementById(`ayah-card-${index}`);
            if (el) {
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          })
          .catch(err => {
            console.error("Gagal memutar audio:", err);
            setIsPlaying(false);
            setFetchError("Audio gagal dimuat. Mengecek jalur cadangan...");
            // Retry fallback URL
            const fallbackUrl = `https://cdn.islamic.network/quran/audio/128/${reciter}/${ayah.globalNumber}.mp3`;
            audioRef.current.src = fallbackUrl;
            audioRef.current.play().then(() => setIsPlaying(true)).catch(e => {
              setFetchError("Audio tidak dapat diputar. Periksa koneksi internet.");
            });
          });
      };

      const togglePlayPause = () => {
        if (isPlaying) {
          audioRef.current.pause();
          setIsPlaying(false);
          if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);
          setIsPauseCountdown(false);
        } else {
          if (verses.length > 0) {
            playAyah(currentAyahIndex);
          }
        }
      };

      const stopAudio = () => {
        audioRef.current.pause();
        audioRef.current.currentTime = 0;
        setIsPlaying(false);
        setCurrentAyahIndex(0);
        setCurrentRepeatCount(1);
        if (countdownTimerRef.current) clearInterval(countdownTimerRef.current);
        setIsPauseCountdown(false);
      };

      // Quiz mode setup
      const setupQuizMode = (vList) => {
        if (!vList || vList.length < 2) return;
        const qIdx = Math.floor(Math.random() * (vList.length - 1));
        setQuizIndex(qIdx);
        setQuizAnswerFeedback(null);

        const correctNextAyah = vList[qIdx + 1];
        let choices = [correctNextAyah];

        // Pick 2 or 3 random wrong options
        while (choices.length < Math.min(3, vList.length)) {
          const randIdx = Math.floor(Math.random() * vList.length);
          if (randIdx !== qIdx + 1 && !choices.includes(vList[randIdx])) {
            choices.push(vList[randIdx]);
          }
        }

        // Shuffle choices
        choices.sort(() => Math.random() - 0.5);
        setQuizOptions(choices);
      };

      const handleAnswerQuiz = (selectedAyah) => {
        const correctNext = verses[quizIndex + 1];
        if (selectedAyah.numberInSurah === correctNext.numberInSurah) {
          setQuizAnswerFeedback('correct');
          setQuizScore(prev => prev + 10);
          setTimeout(() => {
            setupQuizMode(verses);
