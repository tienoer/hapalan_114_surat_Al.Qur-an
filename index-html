                    ))}
                  </div>
                </div>

                {/* COMPLETED SURAHS DETAILED BREAKDOWN */}
                <div className="bg-white rounded-3xl p-6 shadow-md border border-slate-200 space-y-4">
                  <div className="flex items-center justify-between">
                    <h3 className="text-lg font-bold text-slate-800">Daftar Surat Selesai Dihafal</h3>
                    {stats.completedSurahCount > 0 && (
                      <button
                        onClick={() => {
                          if (window.confirm("Apakah Anda yakin ingin menghapus semua catatan progres hafalan?")) {
                            setMemorizedData({});
                          }
                        }}
                        className="text-xs text-rose-600 hover:underline font-bold"
                      >
                        Reset Semua Progres
                      </button>
                    )}
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    {ALL_114_SURAHS.filter(s => (memorizedData[s.number] || []).length > 0).map(s => {
                      const list = memorizedData[s.number] || [];
                      const isComplete = list.length === s.ayahCount;
                      return (
                        <div key={s.number} className="p-3 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-between">
                          <div>
                            <div className="font-bold text-slate-800 text-sm">{s.latin}</div>
                            <div className="text-xs text-slate-500">{list.length} / {s.ayahCount} Ayat</div>
                          </div>
                          <span className={`px-2 py-1 rounded-lg text-xs font-bold ${
                            isComplete ? 'bg-emerald-600 text-white' : 'bg-amber-100 text-amber-800'
                          }`}>
                            {isComplete ? 'Selesai ✓' : 'Progres'}
                          </span>
                        </div>
                      );
                    })}

                    {Object.keys(memorizedData).length === 0 && (
                      <div className="col-span-full text-center py-8 text-slate-400 text-sm italic">
                        Belum ada ayat yang ditandai sebagai hafal. Buka surat dan tandai ayat yang telah kamu kuasai!
                      </div>
                    )}
                  </div>
                </div>

              </div>
            )}

          </main>

          {/* FLOATING AUDIO CONTROL PLAYER (ALWAYS ACTIVE WHEN SURAH WORKBENCH OPEN) */}
          {view === 'workbench' && selectedSurah && (
            <div className="fixed bottom-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-md text-white border-t border-emerald-500/30 px-4 py-3 shadow-2xl">
              <div className="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
                
                {/* Active Ayah & Surah Label */}
                <div className="flex items-center gap-3 w-full md:w-auto justify-between md:justify-start">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-xl bg-emerald-700 text-gold-300 flex items-center justify-center font-extrabold text-sm shadow-md">
                      {verses[currentAyahIndex]?.numberInSurah || 1}
                    </div>
                    <div>
                      <div className="font-bold text-sm text-gold-300">
                        {selectedSurah.latin} : Ayat {verses[currentAyahIndex]?.numberInSurah || 1}
                      </div>
                      <div className="text-[11px] text-slate-400 flex items-center gap-2">
                        <span>Mode: <strong className="text-emerald-400 uppercase">{mode}</strong></span>
                        <span>•</span>
                        <span>Ulang: <strong className="text-gold-400">{repeatTarget}x</strong> ({currentRepeatCount}/{repeatTarget})</span>
                      </div>
                    </div>
                  </div>

                  {/* Mobile Quick Play/Pause */}
                  <div className="flex md:hidden items-center gap-2">
                    <button
                      onClick={togglePlayPause}
                      className="w-10 h-10 rounded-full bg-gold-500 text-slate-900 flex items-center justify-center font-extrabold shadow-lg"
                    >
                      {isPlaying ? '⏸' : '▶'}
                    </button>
                  </div>
                </div>

                {/* Primary Player Buttons */}
                <div className="flex items-center gap-3 w-full md:w-auto justify-center">
                  
                  {/* Prev Ayah */}
                  <button
                    onClick={() => {
                      if (currentAyahIndex > 0) playAyah(currentAyahIndex - 1);
                    }}
                    disabled={currentAyahIndex === 0}
                    className="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 disabled:opacity-30 text-white text-sm"
                    title="Ayat Sebelumnya"
                  >
                    ⏮
                  </button>

                  {/* Play / Pause */}
                  <button
                    onClick={togglePlayPause}
                    className="px-6 py-2.5 bg-gradient-to-r from-gold-500 to-amber-400 text-slate-950 font-black rounded-2xl shadow-lg hover:scale-105 transition flex items-center gap-2 text-sm"
                  >
                    <span>{isPlaying ? '⏸ JEDA' : '▶ PUTAR'}</span>
                  </button>

                  {/* Stop */}
                  <button
                    onClick={stopAudio}
                    className="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-rose-400 text-sm"
                    title="Hentikan Audio"
                  >
                    ⏹
                  </button>

                  {/* Next Ayah */}
                  <button
                    onClick={() => {
                      if (currentAyahIndex < verses.length - 1) playAyah(currentAyahIndex + 1);
                    }}
                    disabled={currentAyahIndex === verses.length - 1}
                    className="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 disabled:opacity-30 text-white text-sm"
                    title="Ayat Selanjutnya"
                  >
                    ⏭
                  </button>

                </div>

                {/* Audio Customization Controls */}
                <div className="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end text-xs">
                  
                  {/* Ayah Repeat Selector */}
                  <div className="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1.5 rounded-xl border border-slate-700">
                    <span className="text-slate-400">Ulangi:</span>
                    {[1, 3, 5, 10].map(cnt => (
                      <button
                        key={cnt}
                        onClick={() => setRepeatTarget(cnt)}
                        className={`px-2 py-0.5 rounded-md font-bold transition ${
                          repeatTarget === cnt ? 'bg-gold-500 text-slate-900' : 'text-slate-300 hover:bg-slate-700'
                        }`}
                      >
                        {cnt}x
                      </button>
                    ))}
                  </div>

                  {/* Playback Speed */}
                  <div className="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1.5 rounded-xl border border-slate-700">
                    <span className="text-slate-400">Laju:</span>
                    <select
                      value={playbackSpeed}
                      onChange={(e) => setPlaybackSpeed(parseFloat(e.target.value))}
                      className="bg-transparent text-gold-300 font-bold focus:outline-none"
                    >
                      <option value="0.75" className="bg-slate-900 text-white">0.75x (Pelan)</option>
                      <option value="1" className="bg-slate-900 text-white">1.0x (Normal)</option>
                      <option value="1.25" className="bg-slate-900 text-white">1.25x (Cepat)</option>
                      <option value="1.5" className="bg-slate-900 text-white">1.5x (Kilat)</option>
                    </select>
                  </div>

                </div>

              </div>
            </div>
          )}

          {/* FOOTER */}
          <footer className="bg-slate-900 text-slate-400 py-6 text-center text-xs border-t border-slate-800">
            <div className="max-w-7xl mx-auto px-4 space-y-4">
              <div className="flex flex-col sm:flex-row items-center justify-center gap-4 text-slate-300">
                <img 
                  src="https://iili.io/nokHlP1.png" 
                  alt="SDN 3 Bangunharja" 
                  className="w-10 h-10 object-contain rounded-lg border border-slate-700 p-0.5 bg-white"
                  onError={(e)=>{ e.target.onerror=null; e.target.src='https://placehold.co/100x100/064e3b/facc15?text=SDN3'; }} 
                />
                <div className="text-center sm:text-left">
                  <div className="font-bold text-slate-200 text-sm">SDN 3 BANGUNHARJA</div>
                  <div className="text-[11px] text-slate-400">Kecamatan Cisaga, Kabupaten Ciamis</div>
                </div>
                <div className="hidden sm:block h-8 w-px bg-slate-700 mx-2"></div>
                <div className="flex items-center gap-2">
                  <img 
                    src="https://iili.io/CZBdZ6x.jpg" 
                    alt="ETI, S.Pd.SD" 
                    className="w-8 h-8 rounded-full object-cover border border-gold-400"
                    onError={(e)=>{ e.target.onerror=null; e.target.src='https://placehold.co/100x100/065f46/ffffff?text=ETI'; }} 
                  />
                  <div className="text-left">
                    <div className="font-bold text-gold-300 text-xs">ETI, S.Pd.SD</div>
                    <div className="text-[10px] text-slate-400">Penyusun & Pengembang Aplikasi</div>
                  </div>
                </div>
              </div>
              <p className="font-semibold text-slate-400">
                Hafalan 114 Surat Al-Qur'an — Belajar, Mendengarkan, & Menghafal Interaktif
              </p>
              <p className="text-slate-500 text-[11px]">
                Audio Murottal disediakan secara resmi dari server Al-Qur'an Cloud & EverydayQuran.
              </p>
            </div>
          </footer>

        </div>
      );
    }

    // Render React Application
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
